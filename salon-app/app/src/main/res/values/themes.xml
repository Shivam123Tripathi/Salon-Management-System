<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SalonApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/salon_gold</item>
        <item name="colorPrimaryVariant">@color/salon_gold_dark</item>
        <item name="colorOnPrimary">@color/salon_black</item>
        <item name="colorSecondary">@color/salon_gold_light</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/salon_black</item>
        <item name="android:navigationBarColor">@color/salon_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="SalonButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/salon_black</item>
        <item name="backgroundTint">@color/salon_gold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- ADDED MISSING STYLES -->
    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/salon_black</item>
        <item name="backgroundTint">@color/salon_gold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="AppTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/salon_gold</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/salon_gold</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="SalonInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/salon_gold</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/salon_gold</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="SalonCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/salon_card_bg</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
    </style>
</resources>
