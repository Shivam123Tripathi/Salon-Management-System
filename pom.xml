<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 
        PARENT: Spring Boot Starter Parent
        This gives us default configurations, dependency management, and plugin versions.
        Think of it as a "template" that Spring Boot provides so we don't have to configure everything manually.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- 
        PROJECT COORDINATES:
        - groupId: Your organization/company identifier (like a package name)
        - artifactId: The project name
        - version: Current version of your app
    -->
    <groupId>com.salon</groupId>
    <artifactId>salon-management-system</artifactId>
    <version>1.0.0</version>
    <name>Salon Management System</name>
    <description>Backend API for Salon Appointment Booking System</description>

    <!-- Java version to compile with -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 
            SPRING BOOT STARTER WEB
            Provides: Embedded Tomcat server, REST API support (@RestController, @GetMapping, etc.)
            Why: This is what lets us create HTTP endpoints that the Android app will call.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!--
            FLYWAY — Database Migration Tool
            WHY: Instead of letting Hibernate auto-create tables (risky in production),
            Flyway runs versioned SQL scripts (V1__init.sql, V2__add_xyz.sql)
            to manage the database schema. Like "Git for your database."

            flyway-core: The migration engine
            flyway-mysql: MySQL-specific support (required since Flyway 10+)
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 
            SPRING BOOT STARTER DATA JPA
            Provides: Hibernate ORM, JpaRepository interface
            Why: Lets us talk to MySQL using Java objects instead of writing raw SQL.
            Example: Instead of "SELECT * FROM users WHERE email = ?", we write findByEmail(email).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 
            SPRING BOOT STARTER SECURITY
            Provides: Authentication, authorization, password encoding, security filters
            Why: Protects our APIs. Only logged-in users can access protected endpoints.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 
            SPRING BOOT STARTER VALIDATION
            Provides: @NotBlank, @Email, @Size, @Valid annotations
            Why: Validates incoming request data. If someone sends empty email, we reject it automatically.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 
            MYSQL CONNECTOR
            Provides: JDBC driver for MySQL
            Why: The actual "bridge" between Java and MySQL database. Without this, Java can't talk to MySQL.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            JJWT (Java JWT) - API, Implementation, and Jackson serializer
            Provides: JWT token creation, parsing, and validation
            Why: After login, we give the user a JWT token. On every subsequent request, 
            they send this token to prove who they are. No need for sessions.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            LOMBOK
            Provides: @Getter, @Setter, @NoArgsConstructor, @AllArgsConstructor, @Builder, @Data
            Why: Eliminates boilerplate code. Instead of writing 50 lines of getters/setters,
            we add one annotation and Lombok generates them at compile time.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 
            SPRINGDOC OPENAPI (Swagger UI)
            Provides: Auto-generated API documentation at /swagger-ui.html
            Why: Creates a beautiful interactive page where you can see and test all your APIs.
            Very useful during development and for the Android developer to understand the API.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <dependency>
            <groupId>com.twilio.sdk</groupId>
            <artifactId>twilio</artifactId>
            <version>10.6.1</version>
        </dependency>

        <!--
            RAZORPAY PAYMENT GATEWAY
            Provides: Payment gateway integration for UPI, Cards, Net Banking
            Why: To process online payments for appointments
        -->
        <dependency>
            <groupId>com.razorpay</groupId>
            <artifactId>razorpay-java</artifactId>
            <version>1.4.6</version>
        </dependency>

        <!--
            SPRING BOOT STARTER MAIL
            Provides: Email sending capabilities via JavaMailSender
            Why: Send OTP via email, booking confirmations, appointment reminders
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--
            FIREBASE ADMIN SDK
            Provides: Firebase Cloud Messaging for push notifications
            Why: Send real-time push notifications to mobile apps
        -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.2.0</version>
        </dependency>

        <!--
            SPRING SECURITY OAUTH2 CLIENT
            Provides: OAuth2 login support (Google, Facebook)
            Why: Enable social login for customers
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!--
            APACHE COMMONS FILE UPLOAD
            Provides: File upload handling
            Why: Upload images for artists and services
        -->
        <dependency>
            <groupId>commons-fileupload</groupId>
            <artifactId>commons-fileupload</artifactId>
            <version>1.5</version>
        </dependency>

        <!--
            SPRING BOOT STARTER TEST
            Provides: JUnit, Mockito, Spring Test utilities
            Why: For writing unit tests and integration tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 
                SPRING BOOT MAVEN PLUGIN
                Lets us run the app with: mvn spring-boot:run
                Also packages the app as an executable JAR for deployment.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Exclude Lombok from the final JAR (it's only needed at compile time) -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
